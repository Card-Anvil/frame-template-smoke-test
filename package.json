{
  "name": "my-card-frames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custom frames for Card Anvil.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "new-frame": "node scripts/new-frame.js",
    "validate": "frame-kit validate",
    "build": "frame-kit build --out dist",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:ci": "prettier --check ."
  },
  "dependencies": {
    "@cardanvil/frame-kit": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^@cardanvil/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "volta": {
    "node": "24.16.0"
  }
}
